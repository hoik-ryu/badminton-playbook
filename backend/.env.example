# Docker 없이 호스트에서 backend 를 실행할 때 사용 (`cp .env.example .env`).
# 실제 값은 backend/.env 에만 두고 커밋·공유하지 마세요. 아래는 자리표시자입니다.
APP_NAME=badminton-playbook
APP_ENV=local
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
CORS_ORIGINS=http://localhost:5173

# --- 카카오 로그인(Kakao Developers 콘솔 > 앱 > 플랫폼 키 > REST API 키) ---
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
# 콘솔에 등록한 값과 정확히 같아야 함(로컬은 Vite 프록시 경유)
KAKAO_REDIRECT_URI=http://localhost:5173/api/auth/kakao/callback

# --- 앱 세션 ---
# 무작위 긴 문자열. 생성: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# local 이 아닌 환경(APP_ENV != local)에서 비어 있으면 서버가 시작하지 않습니다.
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_DAYS=30
# HTTPS 환경에서는 반드시 true. 로컬 http://localhost 는 false
SESSION_COOKIE_SECURE=false

# --- 로컬 개발용 운영진 ID/PW 로그인 ---
# 기본 꺼짐. APP_ENV=local·e2e 에서만 동작하고, 그 밖에서 true 면 서버가 시작하지 않습니다.
# (e2e는 DATABASE_URL이 임시 테스트 DB여야 시작: backend/app/core/dbguard.py)
# 비밀번호는 여기(.env)에서만 읽고 DB·프런트엔드에 저장하지 않습니다.
DEV_LOGIN_ENABLED=false
DEV_ADMIN_USERNAME=super_admin
DEV_ADMIN_PASSWORD=change-me-local-only
