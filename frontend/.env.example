# Docker 없이 호스트에서 frontend 를 실행할 때 사용 (`cp .env.example .env`).
# 비우면 같은 출처(/api → Vite 프록시 → API_PROXY_TARGET)로 호출합니다(권장).
VITE_API_BASE_URL=
# 데이터 출처: mock(기본, 화면 개발용 가짜 데이터) | api(실제 백엔드: 인증·가입 승인·역할만. 명단·오늘 운동·청백전은 아직 Mock)
VITE_DATA_SOURCE=mock
# Vite 개발 서버 프록시 대상(vite.config.ts 전용, 브라우저에 노출되지 않음). 기본 http://localhost:8000
API_PROXY_TARGET=http://localhost:8000
