  "manifest": {
    "schema_version": 1,
    "name": "fullstack-boilerplate",
    "version": "1.0.0",
    "apply": {
      "exclude": []
    },
    "substitutions": [
      {
        "from": "fullstack-boilerplate",
        "to": "{project_slug}",
        "files": [
          ".env.example",
          "backend/.env.example",
          "docker-compose.yml",
          "backend/app/core/config.py",
          "backend/pyproject.toml"
        ]
      },
      {
        "from": "Fullstack Boilerplate",
        "to": "{project_title}",
        "files": [
          "frontend/index.html",
          "frontend/src/pages/HomePage.tsx"
        ]
      }
    ],
    "merge": [
      {
        "path": ".gitignore",
        "strategy": "append-missing-lines",
        "required": [
          ".env",
          ".env.*",
          "!.env.example",
          "node_modules/",
          "dist/",
          ".venv/",
          "__pycache__/",
          ".pytest_cache/",
          ".ruff_cache/",
          ".mypy_cache/"
        ]
      },
      {
        "path": "CLAUDE.md",
        "strategy": "append-section",
        "section_title": "개발 규칙 (fullstack-boilerplate)"
      },
      {
        "path": "README.md",
        "strategy": "append-section",
        "section_title": "개발 환경 (fullstack-boilerplate)"
      }
    ],
    "verify": {
      "env_file": ".env.example",
      "ignored_paths": [
        "frontend/node_modules",
        "frontend/dist",
        "backend/.venv",
        "backend/.pytest_cache",
        "backend/.ruff_cache",
        "backend/.mypy_cache"
      ],
      "ports": {
        "POSTGRES_PORT": 55432,
        "BACKEND_PORT": 58000,
        "FRONTEND_PORT": 55173
      },
      "env": {
        "APP_ENV": "verify",
        "CORS_ORIGINS": "http://localhost:55173",
        "VITE_API_BASE_URL": "http://localhost:58000"
      },
      "stages": {
        "fe": [
          {
            "run": "pnpm install --frozen-lockfile",
            "cwd": "frontend"
          },
          {
            "run": "pnpm lint",
            "cwd": "frontend"
          },
          {
            "run": "pnpm typecheck",
            "cwd": "frontend"
          },
          {
            "run": "pnpm test",
            "cwd": "frontend"
          },
          {
            "run": "pnpm build",
            "cwd": "frontend"
          }
        ],
        "be": [
          {
            "run": "uv sync --frozen",
            "cwd": "backend"
          },
          {
            "run": "uv run ruff check .",
            "cwd": "backend"
          },
          {
            "run": "uv run ruff format --check .",
            "cwd": "backend"
          },
          {
            "run": "uv run mypy app tests",
            "cwd": "backend"
          },
          {
            "run": "uv run pytest",
            "cwd": "backend"
          }
        ],
        "db": [
          {
            "run": "{compose} up -d --wait db"
          },
          {
            "run": "{compose} run --rm --build backend alembic upgrade head"
          },
          {
            "run": "{compose} run --rm backend alembic check"
          },
          {
            "run": "{compose} run --rm backend alembic downgrade base"
          },
          {
            "run": "{compose} run --rm backend alembic upgrade head"
          },
          {
            "run": "{compose} run --rm backend pytest -m db"
          }
        ],
        "smoke": [
          {
            "run": "{compose} up -d --build --wait"
          }
        ]
      },
      "http": [
        {
          "url": "http://localhost:{BACKEND_PORT}/health",
          "expect_status": 200,
          "contains": "\"database\":\"ok\""
        },
        {
          "url": "http://localhost:{FRONTEND_PORT}/",
          "expect_status": 200
        }
      ]
    }
  },
