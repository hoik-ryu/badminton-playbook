# Docker Compose 용 환경변수. `make env` 또는 `cp .env.example .env` 후 필요 시 수정하세요.
# 실제 비밀값은 .env 에만 두고 커밋하지 마세요.

# Compose 프로젝트 이름 (기본값: 디렉터리 이름). 컨테이너/볼륨 이름의 접두사가 됩니다.
# COMPOSE_PROJECT_NAME=my-product

# --- PostgreSQL ---
# 호스트에 PostgreSQL 이 이미 5432 를 쓰면 POSTGRES_PORT 를 바꾸세요 (예: 5433).
# 이때 Docker 없이 backend 를 실행한다면 backend/.env 의 DATABASE_URL 포트도 함께 바꿔야 합니다.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# --- Backend ---
APP_NAME=badminton-playbook
APP_ENV=local
# BACKEND_PORT 를 바꾸면 (VITE_API_BASE_URL 을 쓰는 경우) 함께 바꾸세요.
BACKEND_PORT=8000
# 브라우저에서 접근하는 프론트엔드 Origin (쉼표로 여러 개)
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
# FRONTEND_PORT 를 바꾸면 CORS_ORIGINS 도 함께 바꾸세요.
FRONTEND_PORT=5173
# 브라우저가 호출할 Backend 주소. 비우면 같은 출처(/api → Vite 프록시)로 호출합니다(권장: httpOnly 세션 쿠키·카카오 Redirect URI 전제)
VITE_API_BASE_URL=
# 데이터 출처: mock(기본, 화면 개발용 가짜 데이터) | api(실제 백엔드: 인증·가입 승인·역할만. 명단·오늘 운동·청백전은 아직 Mock)
VITE_DATA_SOURCE=mock
